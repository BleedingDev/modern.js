{
  "name": "bff-api-app",
  "version": "2.66.0",
  "scripts": {
    "dev": "modern dev",
    "dev:bff": "modern dev --api-only",
    "build": "modern build",
    "serve": "modern serve",
    "deploy": "modern deploy",
    "start:bff": "modern serve --api-only",
    "new": "modern new"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@modern-js/plugin-bff": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "@modern-js/server-runtime": "workspace:*",
    "express": "^5.2.1",
    "effect": "4.0.0-rc.112",
    "hono": "^4.13.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "4.2.0",
    "zod": "^4.5.4",
    "@modern-js/bff-effect": "workspace:*",
    "@modern-js/plugin-bff-extensions": "workspace:*",
    "@modern-js/plugin-bff-build-extensions": "workspace:*"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/plugin-bff-build-extensions": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  },
  "exports": {
    "./effect-contract": "./shared/effect/api.ts",
    "./plugin": {
      "import": "./dist-1/plugin/index.js",
      "require": "./dist-1/plugin/index.js",
      "types": "./dist-1/plugin/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "effect-contract": [
        "./shared/effect/api.ts"
      ],
      "plugin": [
        "./dist-1/plugin/index.d.ts"
      ]
    }
  },
  "files": [
    "dist-1/client/**/*",
    "dist-1/runtime/**/*",
    "dist-1/plugin/**/*",
    "dist-1/**/*.d.ts",
    "shared/effect/api.ts"
  ]
