{
  "publicPackage": "@bleedingdev/modern-js-ultramodern-create",
  "releasePlaceholder": "<V>",
  "create": ["my-workspace"],
  "addVertical": ["catalog", "--vertical"],
  "addHeadless": ["inventory", "--vertical", "--preset", "api-only"],
  "addUiOnly": ["catalog-ui", "--vertical", "--preset", "ui-only"],
  "addHorizontal": ["shared-ui", "--vertical", "--horizontal-remote"],
  "addRpc": ["orders", "--vertical", "--api-protocol", "rpc"],
  "identityBackfill": ["ultramodern", "sync-delivery-unit"],
  "staticAcceptance": ["pnpm", "check"],
  "nodeBuild": ["pnpm", "build"],
  "cloudflareBuild": ["pnpm", "cloudflare:build"],
  "apiCheckExitCodes": {
    "valid": 0,
    "diagnostics": 1,
    "toolFailure": 2
  }
}
