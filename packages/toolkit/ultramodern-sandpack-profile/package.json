{
  "name": "@modern-js/ultramodern-sandpack-profile",
  "description": "Fork-owned executable Sandpack profile for UltraModern.js applications.",
  "homepage": "https://bleedingdev.github.io/ultramodern.js/",
  "bugs": "https://github.com/BleedingDev/ultramodern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/BleedingDev/ultramodern.js",
    "directory": "packages/toolkit/ultramodern-sandpack-profile"
  },
  "license": "MIT",
  "version": "3.8.3",
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "build": "rslib build",
    "dev": "rslib build --watch",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:build-smoke": "node --experimental-strip-types --test tests/*.smoke.ts"
  },
  "engines": {
    "node": ">=26.7.0"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "1.0.0",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@modern-js/i18n-integration": "workspace:*",
    "@modern-js/runtime-renderer-extensions": "workspace:*",
    "@modern-js/plugin-i18n": "workspace:*",
    "@modern-js/plugin-tanstack": "workspace:*",
    "@modern-js/runtime": "workspace:*",
    "effect": "4.0.0-rc.112",
    "i18next": "26.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@modern-js/ultramodern-app-tools": "workspace:*",
    "@modern-js/app-tools": "workspace:*",
    "@modern-js/tsconfig": "workspace:*",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "playwright": "^1.63.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
