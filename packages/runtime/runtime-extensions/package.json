{
  "name": "@modern-js/runtime-extensions",
  "description": "Fork-owned UltraModern.js runtime transaction, streaming, and safe failure primitives.",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/bleedingdev/modern.js",
    "directory": "packages/runtime/runtime-extensions"
  },
  "license": "MIT",
  "version": "3.8.3",
  "engines": {
    "node": ">=26.7.0"
  },
  "types": "./src/index.ts",
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.ts",
      "node": {
        "import": "./dist/esm-node/index.mjs",
        "require": "./dist/cjs/index.js"
      },
      "default": "./dist/esm/index.mjs"
    },
    "./node": {
      "types": "./dist/types/node.d.ts",
      "modern:source": "./src/node.ts",
      "node": {
        "import": "./dist/esm-node/node.mjs",
        "require": "./dist/cjs/node.js"
      },
      "default": "./dist/esm-node/node.mjs"
    },
    "./rsc-html-stream": {
      "types": "./dist/types/rscHtmlStream.d.ts",
      "modern:source": "./src/rscHtmlStream.ts",
      "node": {
        "import": "./dist/esm-node/rscHtmlStream.mjs",
        "require": "./dist/cjs/rscHtmlStream.js"
      },
      "default": "./dist/esm-node/rscHtmlStream.mjs"
    },
    "./safe-failure": {
      "types": "./dist/types/safeFailure.d.ts",
      "modern:source": "./src/safeFailure.ts",
      "node": {
        "import": "./dist/esm-node/safeFailure.mjs",
        "require": "./dist/cjs/safeFailure.js"
      },
      "default": "./dist/esm/safeFailure.mjs"
    },
    "./build-identity": {
      "types": "./dist/types/buildIdentity.d.ts",
      "modern:source": "./src/buildIdentity.ts",
      "node": {
        "import": "./dist/esm-node/buildIdentity.mjs",
        "require": "./dist/cjs/buildIdentity.js"
      },
      "default": "./dist/esm/buildIdentity.mjs"
    },
    "./rsc-disabled/*": {
      "types": "./dist/types/rsc-disabled/*.d.ts",
      "default": "./dist/esm/rsc-disabled/*.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types/index.d.ts",
        "./src/index.ts"
      ],
      "node": [
        "./dist/types/node.d.ts",
        "./src/node.ts"
      ],
      "rsc-html-stream": [
        "./dist/types/rscHtmlStream.d.ts",
        "./src/rscHtmlStream.ts"
      ],
      "safe-failure": [
        "./dist/types/safeFailure.d.ts",
        "./src/safeFailure.ts"
      ],
      "build-identity": [
        "./dist/types/buildIdentity.d.ts",
        "./src/buildIdentity.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "only-allow-pnpm",
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest"
  },
  "devDependencies": {
    "@modern-js/rslib": "workspace:*",
    "@rslib/core": "1.0.0",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^26.4.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "types": "./dist/types/index.d.ts"
  }
}
